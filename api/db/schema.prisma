datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

model Tag {
  uuidTag  String   @id @default(uuid())
  tagTitleNormalized  String @unique
  tagTitleWithDiacritics String?
  tagDescription String?
  tagWeight Int
  images    Image[]
}

model Image {
  uuidImage  String   @id @default(uuid())
  imageFileExtension String
  imageUploadURL String?
  tags       Tag[]
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  hashedPassword      String
  salt                String
  resetToken          String?
  resetTokenExpiresAt DateTime?
}
